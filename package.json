{
  "name": "mini-erp",
  "private": true,
  "version": "0.1.0",
  "description": "mini-erp — monorepo (Dimas standard)",
  "workspaces": [
    "apps/web",
    "apps/e2e",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "cd apps/api && air",
    "build:web": "npm run build -w apps/web",
    "build:api": "cd apps/api && go build -buildvcs=false -o ../../dist/api ./cmd/server",
    "migrate:up": "node scripts/migrate.mjs up",
    "migrate:down": "node scripts/migrate.mjs down 1",
    "migrate:create": "cd apps/api && migrate create -ext sql -dir migrations -seq",
    "sqlc:generate": "node scripts/sqlc-sync.mjs && cd apps/api && sqlc generate",
    "arch:check": "node scripts/arch-check.mjs",
    "arch:selftest": "node scripts/arch-check.mjs --self-test",
    "sqlc:sync": "node scripts/sqlc-sync.mjs",
    "contract:check": "node scripts/contract-check.mjs",
    "test:db": "node scripts/test-db.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:fast": "node scripts/verify.mjs --fast",
    "test:e2e": "npm run test -w apps/e2e",
    "ui:ratchet": "node scripts/ui-ratchet.mjs",
    "plan:check": "node scripts/plan-check.mjs"
  }
}
