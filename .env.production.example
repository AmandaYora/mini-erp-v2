# .env PRODUKSI — VPS elcodelabs (ADR-0019, docs/DEPLOYMENT.md §4–6).
# Salin ke ~/minierp/.env di server, isi nilai asli, lalu `chmod 600 .env`.
# Berkas ini AMAN dikomit: tanpa rahasia. Jangan pernah komit .env yang sudah terisi.
# Server menolak start (gagal keras) bila aturan produksi dilanggar — lihat pesan di log.

APP_ENV=production
APP_PORT=8080
APP_NAME=mini-erp
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id-ID

# --- Database: MySQL di HOST, 1 database + 1 user khusus (SERVER_PLAYBOOK) -------------
# Dibuat sekali di host (password: openssl rand -hex 24 — hex agar aman di URL migrate):
#   CREATE DATABASE minierp_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'minierp_user'@'172.%' IDENTIFIED WITH mysql_native_password BY '<hex>';
#   GRANT ALL PRIVILEGES ON minierp_db.* TO 'minierp_user'@'172.%';
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=minierp_user
DB_PASSWORD=<isi-hex-acak>
DB_NAME=minierp_db
# DSN Go (tanpa skema). Dipakai app DAN `migrate` (deploy.sh -> "mysql://${DB_DSN}").
DB_DSN=minierp_user:<isi-hex-acak>@tcp(host.docker.internal:3306)/minierp_db

# --- Rahasia aplikasi (openssl rand -hex 32; keduanya WAJIB beda) ----------------------
JWT_SECRET=<isi-hex-acak-min-32>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
MEDIA_SIGNING_KEY=<isi-hex-acak-beda-dari-JWT>
# Token bearer untuk /api/v1/metrics (nginx tetap deny dari luar).
METRICS_TOKEN=<isi-hex-acak>

# --- HTTP di belakang nginx host -------------------------------------------------------
# Origin publik eksplisit (jangan '*'). Tambahkan domain lain dipisah koma bila perlu.
CORS_ALLOWED_ORIGINS=https://<domain>
# nginx host terlihat dari bridge docker (172.16.0.0/12); tanpa ini semua pengguna tampak
# satu IP dan pembatas login menolak mereka bersamaan.
TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1/32
CLIENT_IP_HEADER=X-Forwarded-For

# --- Berkas -----------------------------------------------------------------------------
# Disajikan dari image (Dockerfile); biarkan apa adanya.
PUBLIC_DIR=/app/public
# Path di DALAM container (volume ./data/storage). Wajib absolut di produksi.
STORAGE_DIR=/data/storage
SESSION_DIR=

# Object storage S3 IDCloudHost — bucket yang SAMA dengan sistem lama (media lama tidak
# dipindah). Unggahan baru wajib di prefix sendiri yang tidak bertumpuk dengan prefix lama;
# prefix lama dilindungi dari penghapusan (F1-9). Konfirmasi nilai prefix sebelum cutover.
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=https://is3.cloudhost.id
STORAGE_BUCKET=mini-erp
STORAGE_REGION=auto
STORAGE_FORCE_PATH_STYLE=true
STORAGE_ACCESS_KEY_ID=<isi>
STORAGE_SECRET_ACCESS_KEY=<isi>
STORAGE_ROOT_PREFIX=vioni
STORAGE_UPLOAD_ROOT_PREFIX=vioni/production-v2/upload
STORAGE_PRODUCT_PREFIX=
STORAGE_PAYMENT_TRANSFER_PREFIX=
STORAGE_DELIVERY_PROOF_PREFIX=
STORAGE_PROTECTED_PREFIXES=vioni/production
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_PUBLIC_BASE_URL=

# --- Seed awal (sekali, setelah migrate pertama) ----------------------------------------
#   docker compose -f docker-compose.prod.yml run --rm --entrypoint ./seed app init
# Password kosong = dibangkitkan & dicetak SEKALI di output; atau isi (>=12 karakter).
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_BRANCH_CODE=UTM
BOOTSTRAP_BRANCH_NAME=Utama

# --- Dikelola deploy.sh (jangan diubah manual) ------------------------------------------
# IMAGE_TAG=<git-sha yang sedang berjalan>
