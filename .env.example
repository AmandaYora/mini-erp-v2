APP_ENV=development
APP_PORT=8080
APP_NAME=mini-erp
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id-ID

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mini_erp_db
# Go DSN (database/sql + MySQL driver) — no scheme prefix.
# scripts/migrate.mjs builds the golang-migrate URL from this on invocation.
DB_DSN=root:@tcp(localhost:3306)/mini_erp_db

JWT_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# seed admin (F1-6): first owner user. Leave the password empty to get a
# generated one printed once; set it (>=12 chars) for a known credential.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
# seed init branch (defaults UTM/Utama, head). Only used when no branch exists.
BOOTSTRAP_BRANCH_CODE=UTM
BOOTSTRAP_BRANCH_NAME=Utama

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Production build directory of the frontend, served by the container.
# Left empty in dev — the frontend is served by Vite instead.
PUBLIC_DIR=

# Local file storage root (dev fallback when STORAGE_DRIVER=local). Relative to
# apps/api in dev. Layout (created automatically):
#   <STORAGE_DIR>/media/     user uploads — the ONLY folder served, under /media/*
#                            and only through signed, expiring URLs
#   <STORAGE_DIR>/_private/  secrets (WhatsApp session) — never served
# Files left by the old layout (everything served from the root) are moved on start.
STORAGE_DIR=./storage
# Optional: keep the WhatsApp session somewhere else. It must NOT be inside <STORAGE_DIR>/media.
SESSION_DIR=
# Optional: dedicated key for signing /media/* URLs. When empty it is derived from
# JWT_SECRET. Changing it invalidates URLs already issued (they are short-lived anyway).
MEDIA_SIGNING_KEY=

# Object storage (S3-compatible, warisan: IDCloudHost). Isi kunci asli di
# deploy; contoh ini aman dikomit (tanpa rahasia).
STORAGE_DRIVER=local
STORAGE_ENDPOINT=https://is3.cloudhost.id
STORAGE_BUCKET=mini-erp
STORAGE_REGION=auto
STORAGE_FORCE_PATH_STYLE=true
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ROOT_PREFIX=vioni
STORAGE_UPLOAD_ROOT_PREFIX=
STORAGE_PRODUCT_PREFIX=
STORAGE_PAYMENT_TRANSFER_PREFIX=
STORAGE_DELIVERY_PROOF_PREFIX=
# F1-9: prefix yang tidak boleh dihapus Archive (mis. prefix production sistem
# lama selama jendela rollback; pisahkan dengan koma). Wajib diisi di production
# bila bucket dipakai bersama sistem lama; upload root tidak boleh bertumpuk
# dengan daftar ini.
STORAGE_PROTECTED_PREFIXES=
STORAGE_SIGNED_URL_TTL_SECONDS=300
STORAGE_PUBLIC_BASE_URL=

# Left empty so the frontend uses the same origin (see the Vite proxy in vite.config.ts).
# Only set this when web and api are actually deployed separately.
VITE_API_BASE_URL=
